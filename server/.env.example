# Backend-Umgebungsvariablen
PORT=3000
DATABASE_URL=postgres://dpsg:dpsg@localhost:5432/dpsg_news
TEST_DATABASE_URL=postgres://dpsg:dpsg@localhost:5432/dpsg_news
# Absolute path to Firebase Admin service account JSON
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Required bootstrap admin account (one-time password flow)
AUTHOR_BOOTSTRAP_USERNAME=admin
AUTHOR_BOOTSTRAP_ONE_TIME_PASSWORD=change_me_now

# Optional runtime hardening
TRUST_PROXY_HOPS=1
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_SESSION_TTL_MINUTES=20
AUTH_REFRESH_SESSION_TTL_HOURS=720
RATE_LIMIT_STORE=memory
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
