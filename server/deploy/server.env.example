# Copy to /opt/dpsg-news/.env on the Linux host

# Docker image is set by GitHub Actions deploy script (SERVER_IMAGE=<sha-tag>)
SERVER_IMAGE=sapza/dpsgnews:latest

# API runtime
PORT=3000

# Postgres runtime
POSTGRES_USER=dpsg
POSTGRES_PASSWORD=please_change_me
POSTGRES_DB=dpsg_news
DATABASE_URL=postgres://dpsg:please_change_me@postgres:5432/dpsg_news

# Absolute host path to Firebase service account JSON
GOOGLE_APPLICATION_CREDENTIALS_FILE=/opt/dpsg-news/secrets/firebase-service-account.json

# Required bootstrap admin account (one-time password flow)
AUTHOR_BOOTSTRAP_USERNAME=admin
AUTHOR_BOOTSTRAP_ONE_TIME_PASSWORD=change_me_now

# Optional runtime hardening
TRUST_PROXY_HOPS=1
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_SESSION_TTL_MINUTES=20
AUTH_REFRESH_SESSION_TTL_HOURS=720
RATE_LIMIT_STORE=memory
# RATE_LIMIT_REDIS_URL=redis://redis:6379
